{
  "name": "portfolio-jennifer-ouedraogo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio bilingue (FR/EN) de Jennifer Ouedraogo — Big Data & Intelligence Artificielle",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
